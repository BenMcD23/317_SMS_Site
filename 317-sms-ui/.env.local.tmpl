AUTH_SECRET="" # Added by `npx auth`. Read more: https://cli.authjs.dev
# Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000

# The API's origin. Locally that's uvicorn; in Vercel it's the Lambda Function
# URL (https://<id>.lambda-url.<region>.on.aws — a trailing slash is fine, it's
# stripped in lib/config.ts).
NEXT_PUBLIC_API_BASE=http://localhost:8000

# Service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=""

# Dev-only: adds the staff/SNCO/NCO sign-in buttons on /login. Never in prod.
AUTH_DEV_BYPASS=1